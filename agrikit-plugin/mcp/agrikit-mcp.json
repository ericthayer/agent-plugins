{
  "mcpServers": {
    "agrikit": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/server/index.mjs"],
      "env": {
        "AGRIKIT_COMPONENTS_DIR": "src/components",
        "AGRIKIT_TOKENS_PATH": "tokens/tokens.json",
        "AGRIKIT_TOKENS_CSS_PATH": "src/styles/tokens.css"
      },
      "tools": ["*"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "tools": ["*"]
    }
  }
}
